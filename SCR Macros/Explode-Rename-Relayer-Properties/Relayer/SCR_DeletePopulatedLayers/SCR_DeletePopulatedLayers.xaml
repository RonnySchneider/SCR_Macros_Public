<StackPanel Background="#FFF3F3F7"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:Wpf="clr-namespace:Trimble.Vce.UI.Controls.Wpf;assembly=Trimble.Vce.UI.Controls"
       xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration" mc:Ignorable="d"  HorizontalAlignment="Stretch"  Margin="4"
       d:DesignWidth="245.277" d:DesignHeight="491.228"  >

    <Label Content="Clean and delete populated layers:"/>
    <CheckBox x:Name="deletelayer" Content="Delete layers (untick to just delete content)"/>

    <GroupBox>
        <GroupBox.Header>
            <RadioButton x:Name="picklayer" Content="Clean 1 specific layer" IsChecked="True"/>
        </GroupBox.Header>
        <Border IsEnabled="{Binding IsChecked, ElementName=picklayer}">
            <StackPanel>
                <Wpf:LayerPicker x:Name="layerpicker"/>
                <Label x:Name="membercount" Content="Member count: "/>
            </StackPanel>
        </Border>
    </GroupBox>

    <GroupBox>
        <GroupBox.Header>
            <RadioButton x:Name="searchlayer" Content="Clean if layer name contains the following text&#xA;(case sensitive)" IsChecked="False"/>
        </GroupBox.Header>
        <Border IsEnabled="{Binding IsChecked, ElementName=searchlayer}" Background="#FF97B9D9">
            <StackPanel>
                <TextBox x:Name="searchtext" Text="" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="1,6,3,6.4"/>
            </StackPanel>
        </Border>
    </GroupBox>

    <GroupBox>
        <GroupBox.Header>
            <RadioButton x:Name="multilayer" Content="Clean multiple layers" IsChecked="False"/>
        </GroupBox.Header>
        <Border IsEnabled="{Binding IsChecked, ElementName=multilayer}" Background="#FF97B9D9">
            <StackPanel>
                <UniformGrid Columns="2">
                    <Label Content="Pre-filter list&#xA;(case insensitive)" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                    <TextBox x:Name="ticklistfilter" Text="" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                </UniformGrid>
                <wfi:WindowsFormsHost x:Name="layerlisthost" Height="400"/>
            </StackPanel>
        </Border>
    </GroupBox>

    <Label x:Name="error" Content="" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#00000000" FontWeight="Bold" Foreground="Red"/>
    <Label x:Name="success" Content=""/>

</StackPanel> 