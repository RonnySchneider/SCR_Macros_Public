<Window Background="#FFF3F3F7"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Wpf="clr-namespace:Trimble.Vce.UI.Controls.Wpf;assembly=Trimble.Vce.UI.Controls"
        Title="SCR_LockViews" Height="400" Width="400" MinHeight="100" MinWidth="200"
        mc:Ignorable="d">




    <Window.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}" x:Key="commonHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="85"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0 - 1st view text-->
            <RowDefinition Height="Auto"/> <!-- 1 - 1st view dropdown-->
            <RowDefinition Height="Auto"/> <!-- 2 - 2nd view text-->
            <RowDefinition Height="Auto"/> <!-- 3 - 2nd dropdown-->
            <RowDefinition Height="12"/>    <!-- 4 - -->
            <RowDefinition Height="Auto"/> <!-- 5 - 3rd view checkbox-->
            <RowDefinition Height="Auto"/> <!-- 6 - 3rd view dropdown-->

            
            <RowDefinition Height="12"/>   <!-- 7 - Empty-->
            <RowDefinition Height="Auto"/> <!-- 8 - lockenabled-->
            <RowDefinition Height="12"/>   <!-- 9 - Empty-->
            <RowDefinition Height="Auto"/> <!-- 10 - Lock Scale-->
            <RowDefinition Height="12"/>   <!-- 11 - Empty-->
            <RowDefinition Height="Auto"/> <!-- 12 - Colorpicker-->
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="1st View"/>
        <ComboBox Grid.Row="1" Grid.Column="0" x:Name="firstviewpicker" VerticalAlignment="Center" VerticalContentAlignment="Center" />
        <Label Grid.Row="2" Grid.Column="0" Content="2nd View"/>
        <ComboBox Grid.Row="3" Grid.Column="0" x:Name="secondviewpicker" VerticalAlignment="Center" VerticalContentAlignment="Center" />

        <Label Grid.Row="4" Grid.Column="0" Content=""/>
        <CheckBox Grid.Row="5" Grid.Column="0" x:Name="thirdviewenabled" Content="Enable 3rd View"/>
        <ComboBox Grid.Row="6" Grid.Column="0" x:Name="thirdviewpicker" IsEnabled="{Binding IsChecked, ElementName=thirdviewenabled}" VerticalAlignment="Center" VerticalContentAlignment="Center" />

        <CheckBox Grid.Row="8" Grid.Column="0" x:Name="lockenabled" Content="View Lock Enabled"/>
        <CheckBox Grid.Row="10" Grid.Column="0" x:Name="lockscale" Content="View Scales locked together"/>
        
        <Grid Grid.Row="12" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Content="Crosshair Colour" HorizontalContentAlignment="Center"/>
            <Wpf:ColorPicker Grid.Row="0" Grid.Column="1" x:Name="colorpicker"/>
        </Grid>
        
    </Grid>



</Window>