<StackPanel Background="#FFF3F3F7"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:Wpf="clr-namespace:Trimble.Vce.UI.Controls.Wpf;assembly=Trimble.Vce.UI.Controls" mc:Ignorable="d"  HorizontalAlignment="Stretch"  Margin="4"
       d:DesignWidth="222" d:DesignHeight="362">

    <StackPanel>
        <RadioButton x:Name="layermode" Content="Whole layer:" GroupName="1" IsChecked="True"/>
        <Wpf:LayerPicker x:Name="layerpickerin" IsEnabled="{Binding IsChecked, ElementName=layermode}"/>
        <RadioButton x:Name="manualmode"  Content="Select some objects" GroupName="1"/>
        <Wpf:MemberSelection x:Name="objs" Height="30" Margin="0" IsEnabled="{Binding IsChecked, ElementName=manualmode}"/>
    </StackPanel>
    <Label Content="Enter elevation attribute name"/>
    <Label Content="Case sensitive - don't include ':'"/>
    <TextBox x:Name="featureattr" Text="Elevation"/>

    <Label Content="Select output layer:"/>
    <Wpf:LayerPicker x:Name="layerpickerout" />

    <Label x:Name="success" Content=""/>
    <Label x:Name="error" Content="" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#00000000" FontWeight="Bold" Foreground="Red"/>

</StackPanel> 