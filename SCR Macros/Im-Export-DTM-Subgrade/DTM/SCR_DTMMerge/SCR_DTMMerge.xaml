<StackPanel Background="#FFF3F3F7"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:Wpf="clr-namespace:Trimble.Vce.UI.Controls.Wpf;assembly=Trimble.Vce.UI.Controls" mc:Ignorable="d"  HorizontalAlignment="Stretch"  Margin="4"
       d:DesignWidth="222" d:DesignHeight="500">
    <!--<Label Content="data from Surface B will override Surface A"/>
    <Label Content=""/>-->
    <Expander x:Name="expander_manualmode" BorderThickness="2,2,2,2" IsExpanded="True" Background="#FFCBECC2" BorderBrush="#FF337C27">

        <Expander.Header>
            <WrapPanel>
                <RadioButton x:Name="manualmode" IsChecked="True" VerticalAlignment="Center" GroupName="group1"/>
                <Label Content="manual 2-surface mode" FontWeight="Bold" FontStyle="Italic" FontSize="13"/>
            </WrapPanel>
        </Expander.Header>
        <StackPanel IsEnabled="{Binding IsChecked, ElementName=manualmode}">

            <Label Content="Surface A"/>
            <UniformGrid Columns="2">
                <Label Content="Pre-Filter&#xA;(case insensitive)" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                <!--the space in "Text" here makes sure that the set of ticks is triggered upon startup-->
                <TextBox x:Name="filter1" Text=" " VerticalAlignment="Center" VerticalContentAlignment="Center" />
            </UniformGrid>
            <Wpf:ComboBoxEntityPicker x:Name="surfacepicker1" VerticalAlignment="Center" VerticalContentAlignment="Center"/>

            <Button x:Name="swapab" Content="Swap A-B &#x1F87B;&#x1F879;" Click="swapab_Click"/>

            <Label Content="Surface B - will override A"/>
            <UniformGrid Columns="2">
                <Label Content="Pre-Filter&#xA;(case insensitive)" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                <!--the space in "Text" here makes sure that the set of ticks is triggered upon startup-->
                <TextBox x:Name="filter2" Text=" " VerticalAlignment="Center" VerticalContentAlignment="Center" />
            </UniformGrid>
            <Wpf:ComboBoxEntityPicker x:Name="surfacepicker2" VerticalAlignment="Center" VerticalContentAlignment="Center"/>

            
        </StackPanel>
    </Expander>

    <Expander x:Name="expander_compositemode" Visibility="Hidden" BorderThickness="2,2,2,2" IsExpanded="False" Background="#FFDABB83" BorderBrush="#FFCD8025">

        <Expander.Header>
            <WrapPanel>
                <RadioButton x:Name="compositemode" IsChecked="False" VerticalAlignment="Center" GroupName="group1"/>
                <Label Content="batch process Composite" FontWeight="Bold" FontStyle="Italic" FontSize="13"/>
            </WrapPanel>

        </Expander.Header>
        <StackPanel IsEnabled="{Binding IsChecked, ElementName=compositemode}">

            <!--<Label Content="batch process Composite"/>-->
            <Wpf:ComboBoxEntityPicker x:Name="compositepicker" VerticalAlignment="Center" VerticalContentAlignment="Center"/>

        </StackPanel>
    </Expander>

            <UniformGrid Columns="2">
                <Label x:Name="stepwidthlabel" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                <Wpf:DistanceEdit x:Name="stepwidth"/>
            </UniformGrid>
    <CheckBox x:Name="usemanualname" Content="define new Surface name yourself" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
    <TextBox x:Name="manualname" IsEnabled="{Binding IsChecked, ElementName=usemanualname}"/>
    <CheckBox x:Name="overwritesurface" Content="overwrite existing Surface" Checked="CheckBoxChanged" Unchecked="CheckBoxChanged"/>
    <StackPanel IsEnabled="{Binding IsChecked, ElementName=overwritesurface}">
        <UniformGrid Columns="2">
            <Label Content="Pre-Filter&#xA;(case insensitive)" VerticalAlignment="Center" VerticalContentAlignment="Center" />
            <!--the space in "Text" here makes sure that the set of ticks is triggered upon startup-->
            <TextBox x:Name="filter3" Text=" " VerticalAlignment="Center" VerticalContentAlignment="Center" />
        </UniformGrid>
        <Wpf:ComboBoxEntityPicker x:Name="surfacepicker3" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
    </StackPanel>
    <!--<Label Content="Step - remove data from"/>
    <UniformGrid Columns="2">
        <RadioButton x:Name="bigger" Content="Surface A" IsChecked="True" GroupName="side"/>
        <RadioButton x:Name="smaller" Content="Surface B" IsChecked="False" GroupName="side"/>
    </UniformGrid>-->

    <Label x:Name="error" Content="" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#00000000" FontWeight="Bold" Foreground="Red"/>
    <Label x:Name="success" Content=""/>

</StackPanel> 