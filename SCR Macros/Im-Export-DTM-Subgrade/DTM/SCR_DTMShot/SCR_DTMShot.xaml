<StackPanel Background="#FFF3F3F7"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:Wpf="clr-namespace:Trimble.Vce.UI.Controls.Wpf;assembly=Trimble.Vce.UI.Controls" mc:Ignorable="d"  HorizontalAlignment="Stretch"  Margin="4"
       d:DesignWidth="300   " d:DesignHeight="872.093">
    <!--<Label Content="shoot a DTM or IFC object"/>-->

    <RadioButton x:Name="shootifc" IsChecked="True" Content="Shoot IFC object(s)"/>
    <StackPanel IsEnabled="{Binding IsChecked, ElementName=shootifc}">
        <Label Content="Select the IFC objects"  Margin="0" />
        <Wpf:MemberSelection x:Name="ifcs" UseLocalSelection="True" UpdateTextOnSelectionChange="False" PreviewGotKeyboardFocus="Selection_PreviewGotFocus" ValueChanged="Selection_ValueChanged"/>
    </StackPanel>
    <RadioButton x:Name="shootdtm" IsChecked="False" Content="Shoot a DTM"/>
    <StackPanel IsEnabled="{Binding IsChecked, ElementName=shootdtm}">
        <Label Content="Select the target surface:"  Margin="0" />
        <Wpf:ComboBoxEntityPicker x:Name="surfacepicker"/>
    </StackPanel>
    <RadioButton x:Name="shootplane" IsChecked="False" Content="Shoot a plane"/>
    <StackPanel IsEnabled="{Binding IsChecked, ElementName=shootplane}">
        <Label Content="Face vertex 1:"/>
        <Wpf:CoordinateEdit x:Name="coordCtl1" ShowElevationIf3D="True" AutoTab="True"/>
        <Label Content="Face vertex 2:"/>
        <Wpf:CoordinateEdit x:Name="coordCtl2" ShowElevationIf3D="True" AutoTab="True"/>
        <Label Content="Face vertex 3:"/>
        <Wpf:CoordinateEdit x:Name="coordCtl3" ShowElevationIf3D="True" AutoTab="True"/>
    </StackPanel>

    <Expander x:Name="expander_usepoints" BorderThickness="2,2,2,2"  Background="#FFCBECC2" BorderBrush="#FF337C27" IsExpanded="True">

        <Expander.Header>
            <WrapPanel>
                <RadioButton x:Name="usepoints" IsChecked="True" GroupName="group1"/>
                <Label Content="Shot defined by 2 points" FontWeight="Bold" FontStyle="Italic" FontSize="13"/>
            </WrapPanel>

        </Expander.Header>
        <StackPanel>
            <Label Content="Select output point layer:"/>
            <Wpf:LayerPicker x:Name="layerpicker"/>
            <Label Content="Shoot from" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
            <Wpf:CoordinateEdit x:Name="coordpick1"/>
            <Label Content="Towards" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
            <Wpf:CoordinateEdit x:Name="coordpick2"/>
        </StackPanel>
    </Expander>
    <Expander x:Name="expander_extendline" BorderThickness="2,2,2,2" Background="#FFDABB83" BorderBrush="#FFCD8025" IsExpanded="False">

        <Expander.Header>
            <WrapPanel>
                <RadioButton x:Name="extendline" IsChecked="False" GroupName="group1"/>
                <Label Content="Extend/trim or break a line" FontWeight="Bold" FontStyle="Italic" FontSize="13"/>
            </WrapPanel>

        </Expander.Header>
        <StackPanel>
            <CheckBox x:Name="breakline" Content="Break line at intersections" IsChecked="False"/>
            <CheckBox x:Name="drawlinepoint" Content="Create a point as well" VerticalAlignment="Center" VerticalContentAlignment="Center" />
            <RadioButton x:Name="singleentity" IsChecked="True" GroupName="extendmode" Content="Single entity - click line end you want to extend"/>
            <StackPanel IsEnabled="{Binding IsChecked, ElementName=singleentity}">
                <Wpf:SelectEntity x:Name="linepicker1"/>
            </StackPanel>
            <RadioButton x:Name="polygonselect" IsChecked="False" GroupName="extendmode" Content="use Polygon or Rectangle to select multiple line ends"/>
            <StackPanel IsEnabled="{Binding IsChecked, ElementName=polygonselect}">
                <Wpf:MemberSelection x:Name="linepickermulti" UseLocalSelection="True" UpdateTextOnSelectionChange="False" PreviewGotKeyboardFocus="Selection_PreviewGotFocus" ValueChanged="Selection_ValueChanged"/>
            </StackPanel>
        </StackPanel>

    </Expander>



        <Label x:Name="error" Content="" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#00000000" FontWeight="Bold" Foreground="Red"/>
        <Label x:Name="success" Content=""/>


</StackPanel> 
    