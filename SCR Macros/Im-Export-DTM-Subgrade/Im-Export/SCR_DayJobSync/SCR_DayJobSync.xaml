<Window Background="#FFF3F3F7"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="SCR_DayJobSync" Height="620" Width="500" MinHeight="400" MinWidth="260"
        mc:Ignorable="d">

    <Window.Resources>
        <!-- explicit ListBoxItem template so hover stays the default light grey and only an
             actually-selected item (clicked, whether or not the list has focus) turns light blue -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="LightGray"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="LightBlue"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- default GroupBox chrome renders as a barely-visible line when hosted via ElementHost inside
             TBC - this explicit template draws its own high-contrast border instead of relying on
             whatever OS/classic theme happens to be active. The frame Border is a separate, undecorated
             grid cell alongside the content (not a parent of it) - a Border with non-zero CornerRadius
             clips its own children to the rounded shape, which was cropping the real controls when they
             were nested inside it. -->
        <Style TargetType="GroupBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="6"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="4"
                                    BorderBrush="#FF707070" BorderThickness="1.5" CornerRadius="4"/>

                            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="#FFF3F3F7" Padding="4,0">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>

                            <ContentPresenter Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0 - "BETA Testing" banner -->
            <RowDefinition Height="Auto"/> <!-- 1 - "Local Download Target" framed group -->
            <RowDefinition Height="Auto"/> <!-- 2 - "Local Excel Register" framed group -->
            <RowDefinition Height="Auto"/> <!-- 3 - reload / region -->
            <RowDefinition Height="Auto"/> <!-- 4 - project -->
            <RowDefinition Height="Auto"/> <!-- 5 - up / path -->
            <RowDefinition Height="Auto"/> <!-- 6 - "move to this subfolder..." note -->
            <RowDefinition Height="Auto"/> <!-- 7 - Connect old Job folder checkbox + textbox -->
            <RowDefinition Height="Auto"/> <!-- 8 - "select JOB file only..." note -->
            <RowDefinition Height="*"/>    <!-- 9 - folder tree / file list -->
            <RowDefinition Height="Auto"/> <!-- 10 - status label -->
            <RowDefinition Height="Auto"/> <!-- 11 - error label -->
            <RowDefinition Height="Auto"/> <!-- 12 - sync button -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="BETA Testing" FontWeight="Bold" FontStyle="Italic" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,6"/>

        <GroupBox Grid.Row="1" Margin="0,0,0,8" Padding="4">
            <GroupBox.Header>
                <TextBlock Text="Local Download Target" FontWeight="Bold" FontStyle="Italic"/>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- local sync folder browse -->
                    <RowDefinition Height="Auto"/> <!-- folder structure explanatory italic note -->
                    <RowDefinition Height="Auto"/> <!-- folder structure template -->
                    <RowDefinition Height="Auto"/> <!-- explanatory italic note -->
                    <RowDefinition Height="Auto"/> <!-- Controller Data checkbox + textbox -->
                    <RowDefinition Height="Auto"/> <!-- TBC checkbox + textbox -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="browseLocalFolderBtn" Grid.Column="0" Content="Local Folder..." Margin="0,0,6,0"/>
                    <TextBlock x:Name="localFolderLabel" Grid.Column="1" Text="(not set)" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Grid>

                <TextBlock Grid.Row="1" Text="define the local subfolder layout under the folder above - placeholders: {YYYY} = year, {YY} = 2-digit year, {MM} = 2-digit month, {YYMM} = {YY}+{MM}, {Job} = job name without suffix" FontStyle="Italic" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,2"/>

                <Grid Grid.Row="2" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Folder Structure" Width="94" Padding="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="folderStructureBox" Grid.Column="1" VerticalAlignment="Center" ToolTip="Placeholders: {YYYY} = year, {YY} = 2-digit year, {MM} = 2-digit month, {YYMM} = 2-digit year+month, {Job} = job name (no suffix). Use / to separate subfolder levels."/>
                </Grid>

                <TextBlock Grid.Row="3" Text="create additional local subfolders - if created data will be stored in Controller Data" FontStyle="Italic" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"/>

                <Grid Grid.Row="4" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="controllerDataEnabledCheckbox" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Create this subfolder - if unticked, files go straight into the local download target folder"/>
                    <Label Grid.Column="1" Content="Controller Data" Width="94" Padding="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="controllerDataBox" Grid.Column="2" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=controllerDataEnabledCheckbox}"/>
                </Grid>

                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="tbcEnabledCheckbox" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Create this subfolder"/>
                    <Label Grid.Column="1" Content="TBC Project" Width="94" Padding="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbcBox" Grid.Column="2" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=tbcEnabledCheckbox}"/>
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Margin="0,0,0,8" Padding="4">
            <GroupBox.Header>
                <TextBlock Text="Local Excel Register" FontWeight="Bold" FontStyle="Italic"/>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- job register (Excel) browse -->
                    <RowDefinition Height="Auto"/> <!-- job register column / start row -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- browse button -->
                        <ColumnDefinition Width="*"/>    <!-- path label -->
                    </Grid.ColumnDefinitions>
                    <Button x:Name="browseJobRegisterBtn" Grid.Column="0" Content="Job Register..." Margin="0,0,6,0" ToolTip="Excel workbook to log each synced job into"/>
                    <TextBlock x:Name="jobRegisterLabel" Grid.Column="1" Text="(not set)" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Label Content="Day Job Column" Padding="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="jobRegisterColumnBox" Width="30" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Column letter to scan for the next empty row, and to write the filename into"/>
                    <Label Content="min Row - ignore empty cells above " Padding="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="jobRegisterStartRowBox" Width="40" VerticalAlignment="Center" ToolTip="Never write above this row (e.g. 2, to skip a header row)"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- reload button -->
                <ColumnDefinition Width="Auto"/> <!-- region label -->
                <ColumnDefinition Width="*"/>    <!-- region combo -->
            </Grid.ColumnDefinitions>

            <Button x:Name="reloadBtn" Grid.Column="0" Content="&#x27F3;" FontSize="14" Width="22" Height="22" Padding="0" Margin="0,0,6,0" ToolTip="Login / Reload Regions (Shift-click for diagnostics)"/>
            <Label Grid.Column="1" Content="Region" Padding="0,0,4,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="regionCombo" Grid.Column="2" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- project label -->
                <ColumnDefinition Width="*"/>    <!-- project combo -->
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="Project" Padding="0,0,4,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="projectCombo" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="upBtn" Content="Up" Width="40" Margin="0,0,6,0"/>
            <TextBlock x:Name="tcPathLabel" Text="/" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <TextBlock Grid.Row="6" Text="move to this subfolder once downloaded" FontStyle="Italic" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"/>

        <Grid Grid.Row="7" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="oldJobFolderEnabledCheckbox" Grid.Column="0" IsChecked="True" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Move the job (and its Files subfolder) into this subfolder on Trimble Connect once downloaded - if unticked, nothing is moved on Connect"/>
            <Label Grid.Column="1" Content="Connect old Job folder" Width="150" Padding="0,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="oldJobFolderBox" Grid.Column="2" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=oldJobFolderEnabledCheckbox}"/>
        </Grid>

        <TextBlock Grid.Row="8" Text="select JOB file only - associated folder is added automatically" FontStyle="Italic" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"/>

        <ListBox x:Name="fileList" Grid.Row="9" Margin="0,0,0,6"/>

        <TextBlock x:Name="statusLabel" Grid.Row="10" Text="" FontSize="11" Foreground="Gray" Margin="0,0,0,4" TextWrapping="Wrap"/>

        <Label x:Name="error" Grid.Row="11" Content="" FontWeight="Bold" Foreground="Red"/>

        <Grid Grid.Row="12" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="syncBtn" Grid.Column="0" Content="Sync" Height="26" Margin="0,0,6,0"/>
            <Button x:Name="helpBtn" Grid.Column="1" Content="Help" Height="26" ToolTip="Help"/>
        </Grid>
    </Grid>
</Window>
