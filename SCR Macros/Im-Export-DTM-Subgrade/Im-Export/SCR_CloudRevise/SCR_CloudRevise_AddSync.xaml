<Window Background="#FFF3F3F7"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Add Sync" Height="420" SizeToContent="Width" MinHeight="300" MinWidth="400"
        mc:Ignorable="d">

    <Window.Resources>
        <!-- explicit ListBoxItem template so hover stays the default light grey and only an
             actually-selected item (clicked, whether or not the list has focus) turns light blue -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="LightGray"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="LightBlue"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="rootGrid" Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0 - column labels -->
            <RowDefinition Height="Auto"/> <!-- 1 - local file 1 browse / civillo refresh -->
            <RowDefinition Height="*"/>    <!-- 2 - local file 1 list / civillo list (rowspan 2-4) -->
            <RowDefinition Height="Auto"/> <!-- 3 - local file 2 browse -->
            <RowDefinition Height="*"/>    <!-- 4 - local file 2 list -->
            <RowDefinition Height="Auto"/> <!-- 5 - add/cancel buttons -->
            <RowDefinition Height="Auto"/> <!-- 6 - error label -->
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Local Source Files"/>
        <Label Grid.Row="0" Grid.Column="2" Content="Civillo Target File"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,4,4">
            <Button x:Name="browseLocalFolderBtn1" Content="Browse File 1 Folder..." HorizontalAlignment="Left"/>
            <Button x:Name="clearLocalFile1Btn" Content="Clear" Margin="4,0,0,0"/>
            <Label Content="12d file" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </StackPanel>

        <ListBox x:Name="localFileList1" Grid.Row="2" Grid.Column="0" MinWidth="180" Margin="0,0,4,4"/>

        <GridSplitter Grid.Row="0" Grid.RowSpan="7" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="#FFCCCCCC" ResizeDirection="Columns" ShowsPreview="True" Cursor="SizeWE" Margin="2,0,2,0"/>

        <!-- civillo column - its own nested Grid (buttons/list/CRS override) so the CRS section sits
             pinned to the bottom of this column regardless of the local-file column's row layout -->
        <Grid Grid.Row="1" Grid.RowSpan="4" Grid.Column="2" Margin="4,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="refreshCivilloFilesBtn" Content="Refresh" HorizontalAlignment="Left"/>
                <Button x:Name="clearCivilloFileBtn" Content="Clear" Margin="4,0,0,0"/>
            </StackPanel>

            <ListBox x:Name="civilloFileList" Grid.Row="1" MinWidth="180"/>

            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                <CheckBox x:Name="manualCrsCheckbox" Content="Manually select CRS" VerticalAlignment="Center"
                          ToolTip="Overrides the Civillo project's own default coordinate system with a specific EPSG code for this sync entry"/>
                <TextBox x:Name="crsFilterBox" Margin="0,4,0,0" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=manualCrsCheckbox}" ToolTip="Type to filter the CRS list below by code or name"/>
                <ComboBox x:Name="crsCombo" Margin="0,4,0,0" MaxDropDownHeight="300" IsEnabled="{Binding IsChecked, ElementName=manualCrsCheckbox}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,4,4">
            <Button x:Name="browseLocalFolderBtn2" Content="Browse File 2 Folder..." HorizontalAlignment="Left"/>
            <Button x:Name="clearLocalFile2Btn" Content="Clear" Margin="4,0,0,0"/>
            <Label Content="linestyle file (optional)" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </StackPanel>

        <ListBox x:Name="localFileList2" Grid.Row="4" Grid.Column="0" MinWidth="180" Margin="0,0,4,4"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,4">
            <Button x:Name="okBtn" Content="Add" Width="70" Margin="0,0,4,0"/>
            <Button x:Name="cancelBtn" Content="Cancel" Width="70"/>
        </StackPanel>

        <Label x:Name="error" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Content="" FontWeight="Bold" Foreground="Red"/>

    </Grid>
</Window>
