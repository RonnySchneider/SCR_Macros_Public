def _build_macrohelp(local_root):
    """Assemble MacroHelp.htm from template + whatever chapter files are present.
    Returns (success, message)."""
    chapters_dir  = os.path.join(local_root, "MacroHelp", "chapters")
    template_file = os.path.join(local_root, "MacroHelp", "MacroHelp_template.htm")
    output_file   = os.path.join(local_root, "MacroHelp", "MacroHelp.htm")

    if not os.path.isfile(template_file):
        return False, "MacroHelp_template.htm not found"
    if not os.path.isdir(chapters_dir):
        return False, "MacroHelp/chapters/ folder not found"

    all_macros = {m for _, _, subs in _HELP_HIERARCHY for _, _, macros in subs for m in macros}
    present    = {m for m in all_macros if os.path.isfile(os.path.join(chapters_dir, m + ".htm"))}

    # ── content ───────────────────────────────────────────────────────────────
    parts = []
    for fname in ("00_News.htm", "00_Installation.htm"):
        p = os.path.join(chapters_dir, fname)
        if os.path.isfile(p):
            with open(p, "r", encoding="utf-8") as f:
                parts.append(f.read())

    for h1_id, h1_label, subcategories in _HELP_HIERARCHY:
        if not any(m in present for _, _, macros in subcategories for m in macros):
            continue
        parts.append(_H1_TEMPLATE.format(h1_id=h1_id, label=h1_label))
        for h2_id, h2_label, macros in subcategories:
            h2_present = [m for m in macros if m in present]
            if not h2_present:
                continue
            parts.append(_H2_TEMPLATE.format(h2_id=h2_id, label=h2_label))
            for macro in macros:
                if macro not in present:
                    continue
                with open(os.path.join(chapters_dir, macro + ".htm"), "r", encoding="utf-8") as f:
                    parts.append(f.read())

    content_block = "".join(parts)

    # ── sidebar ───────────────────────────────────────────────────────────────
    I = "          "
    L = []
    if os.path.isfile(os.path.join(chapters_dir, "00_News.htm")):
        L.append(I + '<li><a href="#News">News</a></li>')
        L.append(I + "<br>")
    if os.path.isfile(os.path.join(chapters_dir, "00_Installation.htm")):
        L.append(I + '<li><a href="#Installation">Installation and Updating</a></li>')
        L.append(I + "<br>")

    for h1_id, h1_label, subcategories in _HELP_HIERARCHY:
        h1_macros = [m for _, _, macros in subcategories for m in macros]
        if not any(m in present for m in h1_macros):
            continue
        L.append(I + '<li><a href="#{}">{}</a>'.format(h1_id, h1_label))
        L.append(I + '  <ul class="customListStyle">')
        for h2_id, h2_label, macros in subcategories:
            if not any(m in present for m in macros):
                continue
            L.append(I + '    <li><a href="#{}">{}</a>'.format(h2_id, h2_label))
            L.append(I + '      <ul class="customListStyle">')
            for macro in macros:
                if macro in present:
                    L.append(I + '        <li><a href="#{}">{}</a></li>'.format(macro, macro))
            L.append(I + "      </ul>")
            L.append(I + "    </li>")
        L.append(I + "  </ul>")
        L.append(I + "</li>")
        L.append(I + "<br>")

    nav_block = "\n".join(L) + "\n"

    # ── assemble ──────────────────────────────────────────────────────────────
    with open(template_file, "r", encoding="utf-8") as f:
        template = f.read()

    result = re.sub(r'[^\S\r\n]*<!-- INSERT-CONTENT -->\r?\n', lambda m: content_block, template)
    result = re.sub(r'[^\S\r\n]*<!-- INSERT-SIDEBAR -->\r?\n', lambda m: nav_block,     result)

    with open(output_file, "w", encoding="utf-8") as f:
        f.write("<!-- GENERATED FILE – edit chapter files in MacroHelp/chapters/ -->\n")
        f.write(result)

    return True, "{} macro(s) included".format(len(present))


