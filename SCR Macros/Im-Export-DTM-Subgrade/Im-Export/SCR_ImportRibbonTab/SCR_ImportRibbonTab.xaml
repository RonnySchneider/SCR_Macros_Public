<StackPanel Background="#FFF3F3F7"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:Wpf="clr-namespace:Trimble.Vce.UI.Controls.Wpf;assembly=Trimble.Vce.UI.Controls" mc:Ignorable="d"  HorizontalAlignment="Stretch"  Margin="4"
       d:DesignWidth="300" d:DesignHeight="480"  >

    <Button x:Name="browsesource" Content="Browse for old Ribbon XML (source)..." Height="42" HorizontalContentAlignment="Center" Click="browsesource_Click" />
    <Label>
        <TextBlock x:Name="sourcefilename" Text="" TextWrapping="Wrap"/>
    </Label>

    <TextBlock Text="Select tab(s) to merge (Ctrl/Shift-click for multiple):" Margin="0,4,0,2" TextWrapping="Wrap"/>
    <ListBox x:Name="tabslist" Height="150" SelectionMode="Extended"/>

    <Button x:Name="browsetarget" Content="Browse for Ribbon XML missing custom tabs (target)..." Height="42" HorizontalContentAlignment="Center" Margin="0,8,0,0" Click="browsetarget_Click" />
    <Label>
        <TextBlock x:Name="targetfilename" Text="" TextWrapping="Wrap"/>
    </Label>

    <TextBlock Text="If the target already has a tab with the same name, the merged copy is renamed with an increment (e.g. &quot;Custom 2&quot;) and merged anyway." Margin="0,8,0,0" TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray" FontSize="11"/>

    <Label VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#00000000">
        <TextBlock x:Name="error" Text="" TextWrapping="Wrap" FontWeight="Bold" Foreground="Red"/>
    </Label>
    <Label VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#00000000">
        <TextBlock x:Name="success" Text="" TextWrapping="Wrap" FontWeight="Bold" Foreground="Green"/>
    </Label>

</StackPanel>
