<StackPanel Background="#FFF3F3F7"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:Wpf="clr-namespace:Trimble.Vce.UI.Controls.Wpf;assembly=Trimble.Vce.UI.Controls" mc:Ignorable="d"  HorizontalAlignment="Stretch"  Margin="4"
       d:DesignWidth="300   " d:DesignHeight="872.093">
    <!--<Label Content="shoot a DTM or IFC object"/>-->


    <Expander x:Name="expander_highlightmode" BorderThickness="2,2,2,2" IsExpanded="True" Background="#FFCBECC2" BorderBrush="#FF337C27">

        <Expander.Header>
            <WrapPanel>
                <RadioButton x:Name="highlightmode" IsChecked="True" VerticalAlignment="Center" GroupName="group1"/>
                <Label Content="highlight only" FontWeight="Bold" FontStyle="Italic" FontSize="13"/>
            </WrapPanel>

        </Expander.Header>
        <StackPanel IsEnabled="{Binding IsChecked, ElementName=highlightmode}">

            <Label Content="works with multi-segment polylines"/>
            <Label Content="checks segment to segment"/>
            <Label Content=""/>
            <Label Content="select Layer for Highlighting Circles:"/>
            <Wpf:LayerPicker x:Name="layerpicker"/>

        </StackPanel>
    </Expander>

    <Expander x:Name="expander_deletemode" BorderThickness="2,2,2,2" IsExpanded="False" Background="#FFDABB83" BorderBrush="#FFCD8025">

        <Expander.Header>
            <WrapPanel>
                <RadioButton x:Name="deletemode" IsChecked="False" VerticalAlignment="Center" GroupName="group1"/>
                <Label Content="delete 2 point segments" FontWeight="Bold" FontStyle="Italic" FontSize="13"/>
            </WrapPanel>
        </Expander.Header>
        <StackPanel IsEnabled="{Binding IsChecked, ElementName=deletemode}">

                <Label Content="i.e. after BIM explode"/>
                <Label Content="will ignore lines with more than 1 segment (2 points)"/>
                <Label Content="uses fast algorithm"/>

        </StackPanel>
    </Expander>

    <Label Content="consider duplicate within" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
    <UniformGrid Columns="2">
        <Label x:Name="hztollabel" Content="horizontal tolerance &lt;&#x3D;" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        <Wpf:DistanceEdit x:Name="hztol"/>
        <Label x:Name="vztollabel" Content="vertical tolerance &lt;&#x3D;" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        <Wpf:DistanceEdit x:Name="vztol"/>
    </UniformGrid>
    
    <Wpf:MemberSelection x:Name="objs" Height="30" Margin="0"/>

    <Label x:Name="error3Dduplicate" Content="" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#00000000" FontWeight="Bold" Foreground="Red"/>
    <Label x:Name="error2Dduplicate" Content="" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#00000000" FontWeight="Bold" Foreground="Orange"/>

    <Label x:Name="error" Content="" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#00000000" FontWeight="Bold" Foreground="Red"/>
    <Label x:Name="success" Content=""/>


</StackPanel> 
    