<StackPanel Background="#FFF3F3F7"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:Wpf="clr-namespace:Trimble.Vce.UI.Controls.Wpf;assembly=Trimble.Vce.UI.Controls" mc:Ignorable="d"  HorizontalAlignment="Stretch"  Margin="4"
       d:DesignWidth="222" d:DesignHeight="749.8" >
    <Label Content="select a Sideslope"/>
    <Wpf:SelectEntity x:Name="sideslopepicker" BorderBrush="Blue" BorderThickness="2" Grid.ColumnSpan="2" Margin="2.8,2.8,2.8,2.8" />

        <StackPanel>
            <UniformGrid Columns="2">
                <Label Content="Start Chainage:" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                <Wpf:StationEdit x:Name="startstation" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,3,0"/>
                <Label Content="End Chainage:" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                <Wpf:StationEdit x:Name="endstation" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,3,0"/>
                <Label Content="Template Name"/>
                <TextBox x:Name="templatename" Text=""/>
                <Label Content="Template Spacing" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                <Wpf:DistanceEdit x:Name="nodespacing" Distance="1.000" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,3,0"/>
            </UniformGrid>
        </StackPanel>

    <StackPanel>
        <Label Content="change global Sideslope rebuild settings" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#00000000" FontWeight="Bold" Foreground="Red"/>
        <UniformGrid Columns="2">
            <Button x:Name="disablebutton" Content="By User" Height="42" HorizontalContentAlignment="Center" Click="rebuildbutton_Click" />
            <Button x:Name="enablebutton" Content="Auto" Height="42" HorizontalContentAlignment="Center" Click="rebuildbutton_Click" />
        </UniformGrid>
    </StackPanel>

    <Label x:Name="error" Content="" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#00000000" FontWeight="Bold" Foreground="Red"/>
    <Label x:Name="success" Content="" VerticalAlignment="Center" VerticalContentAlignment="Center"/>

</StackPanel> 
    