<StackPanel Background="#FFF3F3F7"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:Wpf="clr-namespace:Trimble.Vce.UI.Controls.Wpf;assembly=Trimble.Vce.UI.Controls" mc:Ignorable="d"  HorizontalAlignment="Stretch"  Margin="4"
       d:DesignWidth="260" d:DesignHeight="560">
    <GroupBox Header="Source Data">
        <StackPanel>
            <RadioButton x:Name="modedesign" Content="Design - chorded Design Lines" IsChecked="True" Margin="0,2,0,2"
                         ToolTip="the Vertices lie exactly on the original Geometry (e.g. exported Design Lines with chorded Arcs)&#x0a;every Vertex stays within the Tolerance"/>
            <RadioButton x:Name="modesurvey" Content="Survey - picked up Lines" Margin="0,2,0,2"
                         ToolTip="the Vertices scatter around the real Geometry (e.g. a surveyed Centreline or Kerb)&#x0a;the Elements are fitted by Least Squares and don't pass through the Vertices"/>
            <TextBlock x:Name="surveynote" Visibility="Collapsed" TextWrapping="Wrap" Foreground="DarkOrange" FontWeight="Bold" Margin="18,2,2,2"
                       Text="the Survey fit is iterative and can take a while - from a few seconds up to minutes per Line, longer with a small Scatter and many Vertices"/>
        </StackPanel>
    </GroupBox>
    <Label Content="!!! BETA version - still in development !!!" Background="Red"/>
    <TextBlock Text="rebuild Straights/Arcs and Grades/Vertical Curves from chorded or surveyed Polylines" TextWrapping="Wrap" Margin="5,2,5,4"/>

    <Label Content="Lines"/>
    <Wpf:MemberSelection x:Name="objs" Height="30" Margin="0"/>

    <GroupBox Header="Horizontal">
        <StackPanel>
            <UniformGrid x:Name="designh" Columns="2">
                <Label Content="Tolerance" VerticalAlignment="Center"/>
                <Wpf:DistanceEdit x:Name="htol" Distance="0.002"
                                  ToolTip="max distance of the original Vertices from the new Straights/Arcs"/>
                <Label Content="min Chords per Arc" VerticalAlignment="Center"/>
                <Wpf:NumericEdit x:Name="minarcchords" Value="3"
                                 ToolTip="shorter Arcs are only accepted if they are tangent to the previous Element - otherwise they are treated as Angle Points"/>
            </UniformGrid>
            <UniformGrid x:Name="surveyh" Columns="2" Visibility="Collapsed">
                <Label Content="Point Scatter" VerticalAlignment="Center"/>
                <Wpf:DistanceEdit x:Name="hscatter" Distance="0.05"
                                  ToolTip="expected sideways scatter of the Vertices around the real Line (1 sigma)&#x0a;smaller - more Elements, larger - fewer Elements"/>
                <Label Content="min Element Length" VerticalAlignment="Center"/>
                <Wpf:DistanceEdit x:Name="hminlength" Distance="20"
                                  ToolTip="shortest Straight/Arc - shorter Elements are absorbed by their Neighbours"/>
            </UniformGrid>
            <UniformGrid Columns="2">
                <Label Content="max Radius" VerticalAlignment="Center"/>
                <Wpf:DistanceEdit x:Name="maxradius" Distance="10000"
                                  ToolTip="flatter Curves are treated as Straights"/>
                <Label Content="round Radii to" VerticalAlignment="Center"/>
                <Wpf:DistanceEdit x:Name="roundradius" Distance="0"
                                  ToolTip="0 = no rounding&#x0a;Design - a rounded Radius is only used if all Vertices stay within the Tolerance&#x0a;Survey - the Radii are rounded and the rest of the Line is fitted again"/>
            </UniformGrid>
        </StackPanel>
    </GroupBox>

    <GroupBox Header="Vertical">
        <StackPanel>
            <CheckBox x:Name="fitvertical" Content="fit Grades and Vertical Curves" IsChecked="True" Margin="0,2,0,2"
                      ToolTip="unticked - the original Elevations are kept, every Vertex becomes a VPI"/>
            <StackPanel IsEnabled="{Binding IsChecked, ElementName=fitvertical}">
                <UniformGrid x:Name="designv" Columns="2">
                    <Label Content="Tolerance" VerticalAlignment="Center"/>
                    <Wpf:DistanceEdit x:Name="vtol" Distance="0.002"
                                      ToolTip="max height difference of the original Vertices from the new Grades/Vertical Curves"/>
                    <Label Content="min Chords per Curve" VerticalAlignment="Center"/>
                    <Wpf:NumericEdit x:Name="minvcchords" Value="3"
                                     ToolTip="shorter Vertical Curves are only accepted if they are tangent to the previous Grade"/>
                </UniformGrid>
                <UniformGrid x:Name="surveyv" Columns="2" Visibility="Collapsed">
                    <Label Content="Height Scatter" VerticalAlignment="Center"/>
                    <Wpf:DistanceEdit x:Name="vscatter" Distance="0.02"
                                      ToolTip="expected height scatter of the Vertices around the real Profile (1 sigma)&#x0a;smaller - more Elements, larger - fewer Elements"/>
                    <Label Content="min Element Length" VerticalAlignment="Center"/>
                    <Wpf:DistanceEdit x:Name="vminlength" Distance="20"
                                      ToolTip="shortest Grade/Vertical Curve - shorter Elements are absorbed by their Neighbours"/>
                </UniformGrid>
            </StackPanel>
        </StackPanel>
    </GroupBox>

    <GroupBox Header="Output">
        <StackPanel>
            <Label Content="Line Layer"/>
            <Wpf:LayerPicker x:Name="layerpicker"/>
            <CheckBox x:Name="writecsv" Content="write CSV Report to Downloads" IsChecked="True" Margin="0,4,0,0"/>
        </StackPanel>
    </GroupBox>

    <Label x:Name="error" Content="" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#00000000" FontWeight="Bold" Foreground="Red"/>
    <Label x:Name="success" Content=""/>

</StackPanel>
