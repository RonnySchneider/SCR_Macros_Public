<StackPanel Background="#FFF3F3F7"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:Wpf="clr-namespace:Trimble.Vce.UI.Controls.Wpf;assembly=Trimble.Vce.UI.Controls" mc:Ignorable="d"  HorizontalAlignment="Stretch"  Margin="4"
       d:DesignWidth="222" d:DesignHeight="300">
    <Label Content="!!! BETA version - still in development !!!" Background="Red"/>

    <Label Content="select IFC Objects"/>
    <Wpf:MemberSelection x:Name="objs"/>

    <UniformGrid Columns="2">
        <Label Content="Step Width" VerticalAlignment="Center" VerticalContentAlignment="Center" ToolTip="vertical steps between objects are replaced by steep slopes - the upper edge is moved this far into the higher object's underside"/>
        <Wpf:DistanceEdit x:Name="stepwidth" Distance="0.002" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        <Label Content="Surface Name" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        <TextBox x:Name="surfacename" Text="IFC Underside" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
    </UniformGrid>
    <CheckBox x:Name="gapvoids" Content="gaps between objects as voids" IsChecked="True" Margin="4" ToolTip="ticked - areas not covered by any object are holes in the surface&#x0a;unticked - the surface is interpolated across them"/>

    <Label x:Name="error" Content="" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#00000000" FontWeight="Bold" Foreground="Red"/>
    <Label x:Name="success" Content=""/>

</StackPanel>
