<StackPanel Background="#FFF3F3F7"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:Wpf="clr-namespace:Trimble.Vce.UI.Controls.Wpf;assembly=Trimble.Vce.UI.Controls" mc:Ignorable="d"  HorizontalAlignment="Stretch"  Margin="4"
       d:DesignWidth="222" d:DesignHeight="872.093" >
    <Label Content="create a simple CAD Point"/>


    <Label Content="select Output Layer:"/>
    <Wpf:LayerPicker x:Name="layerpicker"/>
    <Expander x:Name="expander_standardmode" BorderThickness="2,2,2,2" IsExpanded="True" Background="#FFCBECC2" BorderBrush="#FF337C27">

        <Expander.Header>
            <WrapPanel>
                <RadioButton x:Name="standardmode" IsChecked="True" VerticalAlignment="Center" GroupName="group1"/>
                <Label Content="normal Picker mode" FontWeight="Bold" FontStyle="Italic" FontSize="13"/>
            </WrapPanel>

        </Expander.Header>
        <StackPanel IsEnabled="{Binding IsChecked, ElementName=standardmode}">

            <CheckBox x:Name="manualelev" Content="manual Elevation" IsChecked="True" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
            <Wpf:ElevationEdit x:Name="elev" IsEnabled="{Binding IsChecked, ElementName=manualelev}" Height="29" Margin="0"/>
            <Label Content="Pick Point:"/>
            <Wpf:CoordinateEdit x:Name="coordpick1"/>
            <CheckBox x:Name="midpoint" Content="second Point for Quick-MidPoint" IsChecked="False" Checked="midpointChanged" Unchecked="midpointChanged" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
            <StackPanel  IsEnabled="{Binding IsChecked, ElementName=midpoint}">
                <Label Content="Pick Point 2:"/>
                <Wpf:CoordinateEdit x:Name="coordpick2" Height="29" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </Expander>
    <Expander x:Name="expander_linemode" BorderThickness="2,2,2,2" IsExpanded="False" Background="#FFDABB83" BorderBrush="#FFCD8025">

        <Expander.Header>
            <WrapPanel>
                <RadioButton x:Name="linemode" IsChecked="False" VerticalAlignment="Center" GroupName="group1"/>
                <Label Content="XY from line but Z from picker" FontWeight="Bold" FontStyle="Italic" FontSize="13"/>
            </WrapPanel>
        </Expander.Header>
        <StackPanel IsEnabled="{Binding IsChecked, ElementName=linemode}">
                <Label Content="select a line for perpendicular XY position"/>
                <Wpf:SelectEntity x:Name="linepicker1"/>
                <Label Content="select a point for Z position"/>
                <Wpf:CoordinateEdit x:Name="coordpick3"/>
        </StackPanel>
    </Expander>
    
    
    <Label x:Name="error" Content="" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="#00000000" FontWeight="Bold" Foreground="Red"/>
    <Label x:Name="success" Content=""/>

</StackPanel> 
    